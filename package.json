{
  "name": "archipel",
  "version": "0.1.0",
  "description": "Archipel by Orqea — mémoire GraphRAG isolée par board",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait postgres",
    "demo": "tsx --env-file=.env -e \"import('./fake-orqea/demo.ts').then((m) => m.runDemoCli(process.env)).catch((e) => { process.stderr.write(String(e) + '\\n'); process.exitCode = 1; })\"",
    "check": "npm run guard && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "guard": "sh scripts/check-structure.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErwannL/Archipel.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/ErwannL/Archipel/issues"
  },
  "homepage": "https://github.com/ErwannL/Archipel#readme",
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "cytoscape": "^3.34.3",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
