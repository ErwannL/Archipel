# Copy to .env and replace every secret: `cp .env.example .env`.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Postgres (docker compose only) ---
POSTGRES_PASSWORD=change-me-postgres-superuser
ARCHIPEL_DB_PASSWORD=change-me-archipel-app
# Host port for Postgres (127.0.0.1 only). Tests use it.
POSTGRES_PORT=5433

# --- Archipel ---
# Host port for API + UI (127.0.0.1 only).
ARCHIPEL_PORT=8080
# HMAC secret shared with Orqea for service-to-service calls (>= 32 chars).
ARCHIPEL_HMAC_SECRET=change-me-hmac-secret-at-least-32-characters
# Secret used by Orqea to sign UI handoff JWTs (HS256), distinct from the HMAC secret (>= 32 chars).
ARCHIPEL_HANDOFF_SECRET=change-me-handoff-secret-at-least-32-chars
# Secret used by Archipel to sign its own UI session cookies (>= 32 chars).
ARCHIPEL_SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Public URL of the Orqea of this environment ("Retour sur Orqea" link, credits).
# Orqea's compose sets <origin>/apps/return, like SportSplitter.
ARCHIPEL_ORQEA_URL=https://orqea.dev
# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Model provider (embeddings + entity extraction) ---
# fake = deterministic local engine, no network, no key (default).
# openai = any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, Mistral...).
AI_PROVIDER=fake
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Limits ---
MAX_EVENT_BYTES=262144
RATE_LIMIT_PER_MINUTE=1200
WORKER_POLL_MS=500
JOB_MAX_ATTEMPTS=8
